# ==========================================
# 1. Google Cloud Vertex AI (LLM + Nano Banana + Veo)
# ==========================================
# การยืนยันตัวตน: รัน `gcloud auth application-default login`
# หรือระบุพาธไฟล์ Service Account JSON ใน GOOGLE_APPLICATION_CREDENTIALS
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=D:\path\to\service-account.json

LLM_PROVIDER=vertex                         # vertex | gemini | anthropic | openai | mock
LLM_MODEL=gemini-2.5-flash

# ระบบค้นหาสำหรับ 03_factcheck.py (ใช้ Google Search Grounding ของ Vertex AI ได้ทันที)
SEARCH_PROVIDER=vertex_grounding            # vertex_grounding | tavily | brave

# ==========================================
# 2. Image Generation — Nano Banana บน Vertex AI (05_images.py)
# ==========================================
IMAGE_PROVIDER=nano_banana                  # nano_banana | fal | placeholder
NANO_BANANA_MODEL=gemini-2.5-flash-image    # gemini-2.5-flash-image | gemini-3-pro-image-preview

# ==========================================
# 3. Video Motion — Veo บน Vertex AI หรือ FFmpeg Ken Burns (07_render.py)
# ==========================================
VIDEO_MOTION_MODE=veo                       # veo | ken_burns
VEO_MODEL=veo-2.0-generate-001              # veo-2.0-generate-001 | veo-3.0-generate-preview

# ==========================================
# 4. Text-to-Speech — TokenMe Paxa TTS (04_tts.py)
# ==========================================
TTS_PROVIDER=tokenme                        # tokenme | edge_tts | botnoi | elevenlabs
TOKENME_API_KEY=
TOKENME_BASE_URL=https://api.tokenme.limited/api/v1
TOKENME_USER_AGENT=edu-shorts-factory/1.0
TOKENME_MODEL=paxa/paxa-tts-flash-v2
TOKENME_VOICE=mooping

# ==========================================
# 5. Telegram Review Bot (08_review.py)
# ==========================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ==========================================
# 6. Publishing (09_publish.py)
# ==========================================
PUBLISH_MODE=manual_export                  # manual_export | direct_api | ayrshare
YOUTUBE_CLIENT_SECRETS_FILE=client_secret.json
YOUTUBE_TOKEN_FILE=youtube_token.json
TIKTOK_ACCESS_TOKEN=
AYRSHARE_API_KEY=
